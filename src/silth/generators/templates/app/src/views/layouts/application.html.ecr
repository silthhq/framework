<!doctype html>
<html lang="<%= current_locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title><%= yield_content(:title, "") %><%= content_for?(:title) ? " · " : "" %>__APP_TITLE__</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <%= csrf_meta_tags %>
  <%= stylesheet_tag "app.css" %>
  <%= importmap_tags %>
  <%= silth_scripts %>
</head>
<body>
  <header class="topbar">
    <a href="/" class="brand"><svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M16 2C22.3 2 26 7 26 13.6C26 21 21.6 27.4 16 30C10.4 27.4 6 21 6 13.6C6 7 9.7 2 16 2ZM9.6 15.4a2.6 4.9 0 1 0 5.2 0a2.6 4.9 0 1 0 -5.2 0ZM17.2 15.4a2.6 4.9 0 1 0 5.2 0a2.6 4.9 0 1 0 -5.2 0Z"/></svg> __APP_TITLE__</a>
    <nav>
      <a href="/" class="<%= active_class("/", exact: true) %>"><%= t("nav.home") %></a>
      <a href="/counter" class="<%= active_class("/counter") %>">Live</a>
      <% if Silth.router.has_route?("login") %>
        <% if ctx.auth_user %>
          <%= button_to t("nav.logout"), "/logout", method: "delete", class: "btn btn-ghost" %>
        <% else %>
          <a href="/login"><%= t("nav.login") %></a>
        <% end %>
      <% end %>
    </nav>
  </header>
  <main class="container">
    <%= flash_messages %>
    <%= content %>
  </main>
  <footer class="footer"><span>Built with</span><a href="https://silth.dev">Silth</a></footer>
</body>
</html>
