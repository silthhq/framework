<!doctype html>
<html><body style="margin:0;background:#07080c;font-family:-apple-system,Segoe UI,Roboto,sans-serif;color:#ecebf5">
  <table width="100%" cellpadding="0" cellspacing="0" style="padding:32px 12px"><tr><td align="center">
    <table width="560" cellpadding="0" cellspacing="0" style="background:#0b0d13;border:1px solid #1f2330;border-radius:8px;padding:32px;text-align:left">
      <tr><td style="font-size:15px;line-height:1.6">
        <%= content %>
      </td></tr>
    </table>
    <p style="color:#868ba3;font-size:12px">__APP_TITLE__</p>
  </td></tr></table>
</body></html>
