# Multi-stage build producing a small static-ish image.
FROM crystallang/crystal:1.22-alpine AS build
WORKDIR /app
RUN apk add --no-cache sqlite-dev sqlite-static
COPY shard.yml shard.lock* ./
RUN shards install --production
COPY . .
RUN shards build __APP_NAME__ cli --release --static --no-debug && \
    SILTH_ENV=production ./bin/cli assets:build

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && adduser -D app
WORKDIR /app
COPY --from=build /app/bin /app/bin
COPY --from=build /app/public /app/public
COPY --from=build /app/config /app/config
USER app
ENV SILTH_ENV=production PORT=3000
EXPOSE 3000
CMD ["/app/bin/__APP_NAME__"]
