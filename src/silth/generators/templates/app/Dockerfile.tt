# Multi-stage build on the official Silth images (docker/ in silthhq/framework), tagged
# by release line. Override them with --build-arg SILTH_BUILDER=… / SILTH_RUNTIME=….
ARG SILTH_BUILDER=ghcr.io/silthhq/builder:__SILTH_IMAGE__
ARG SILTH_RUNTIME=ghcr.io/silthhq/runtime:__SILTH_IMAGE__

FROM ${SILTH_BUILDER} AS build
WORKDIR /app
COPY shard.yml shard.lock* ./
RUN shards install --production
COPY . .
RUN shards build __APP_NAME__ cli --release --static --no-debug && \
    SILTH_ENV=production ./bin/cli assets:build

FROM ${SILTH_RUNTIME}
COPY --from=build --chown=app /app/bin /app/bin
COPY --from=build --chown=app /app/public /app/public
COPY --from=build --chown=app /app/config /app/config
CMD ["/app/bin/__APP_NAME__"]
