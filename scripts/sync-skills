#!/bin/sh
# Copies the application skill (skills/silth) into the `silth new` template,
# which embeds it at compile time.
set -e
root="$(cd "$(dirname "$0")/.." && pwd)"
dest="$root/src/silth/generators/templates/app/dot.claude/skills/silth"
rm -rf "$dest"
mkdir -p "$dest"
cp -R "$root/skills/silth/." "$dest/"
echo "Skill synced into $dest — rebuild bin/silth to embed it."
